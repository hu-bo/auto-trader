{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "output/node",
    "outDir": "dist/node",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "emitDeclarationOnly": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["output/node/**/*.ts"],
  "exclude": ["node_modules"]
}
