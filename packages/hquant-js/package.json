{
  "name": "@hquant/js",
  "version": "0.1.10",
  "description": "High-performance quantitative trading engine powered by Rust",
  "keywords": [
    "quant",
    "indicator",
    "strategy",
    "trading",
    "backtest",
    "rust",
    "napi"
  ],
  "author": "hubo <hubo9@qq.com>",
  "license": "GPL-3.0-or-later",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "__test__"
  },
  "files": [
    "lib",
    "native"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:native": "cd ../hquant-rs && cargo build --release --features ffi-node && cp target/release/libhquant.dylib ../hquant-js/native/hquant.node || cp target/release/libhquant.so ../hquant-js/native/hquant.node",
    "test": "jest --colors --onlyChanged",
    "test:e2e": "jest --colors __test__/e2e.test.ts"
  },
  "devDependencies": {
    "@swc/core": "^1.6.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.3",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.9",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
