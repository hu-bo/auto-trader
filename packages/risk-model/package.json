{
  "name": "@hquant/risk-model",
  "version": "0.0.1",
  "private": true,
  "description": "Risk control engine for trading systems - pluggable, replayable, explainable",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
