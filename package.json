{
  "name": "auto-trader",
  "private": true,
  "version": "1.0.0",
  "description": "Virtual currency quantitative trading server",
  "keywords": [
    "quant",
    "indicator",
    "strategy",
    "trader"
  ],
  "author": "hubo9@qq.com",
  "homepage": "https://github.com/H-jx/auto-trader.git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H-jx/auto-trader.git"
  },
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "publish": "pnpm -r publish",
    "publish:canary": "pnpm -r publish --tag canary",
    "add": "pnpm --filter <scope> add <package>",
    "clean": "rm -rf node_modules && pnpm -r exec -- rm -rf node_modules",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "version": "pnpm -r version",
    "version:patch": "pnpm -r version patch",
    "version:minor": "pnpm -r version minor",
    "version:major": "pnpm -r version major",
    "diff": "git diff",
    "exec": "pnpm -r exec -- <command>"
  },
  "devDependencies": {
    "@swc/core": "^1.13.3",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
