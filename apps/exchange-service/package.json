{
  "name": "@hquant/exchange-service",
  "version": "1.0.0",
  "description": "Exchange trading service for quantitative trading system",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "proto:generate": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/grpc/generated --grpc_out=grpc_js:./src/grpc/generated --ts_out=./src/grpc/generated -I./proto ./proto/*.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@hquant/exchange-adapter": "workspace:*",
    "@hquant/logger-js": "workspace:*",
    "@hquant/risk-model": "workspace:*",
    "config": "^3.3.9",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "koa": "^3.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^13.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2"
  }
}
