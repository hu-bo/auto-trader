# Environment
# This service uses the `config` package (see `config/`).
# These env vars are read via `config/custom-environment-variables.yaml`.
NODE_ENV=development

# Server
PORT=9008
HOST=0.0.0.0
GRPC_PORT=50051

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trader
DB_USER=trader_user
DB_PASSWORD=123456
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Exchange Settings
DEMONET=true
PROXY=
SOCKS_PROXY=

# Risk Control
RISK_ENABLED=true
RISK_MAX_DAILY_LOSS=500
RISK_MAX_MARGIN_USAGE_PCT=0.8
RISK_DEFAULT_STOP_LOSS_PCT=0.05
RISK_DEFAULT_STOP_PROFIT_PCT=0.1

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_DIR=logs

# Token
TOKEN_SECRET=exchange-service-secret-key
TOKEN_EXPIRE_HOURS=24
