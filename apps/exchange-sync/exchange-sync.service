[Unit]
Description=Exchange Sync Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/app/exchange-sync
ExecStart=/data/app/exchange-sync/exchange-sync
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 环境变量（可选）
# Environment=GIN_MODE=release

# 资源限制（可选）
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
