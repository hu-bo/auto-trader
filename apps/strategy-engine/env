APP_ENV=development
APP_PORT=9002

# Signal NATS — publish signals & notifications to trader-service-node
SIGNAL_NATS_URL=nats://localhost:16001
SIGNAL_NATS_USER=strategy_engine
SIGNAL_NATS_PASS=123456
SIGNAL_SUBJECT_PREFIX=sig.v1
SIGNAL_STRATEGY_SUBJECT_PREFIX=sig.v1.signal

# Upstream NATS — subscribe candle data from exchange-adapter-service (HK)
UPSTREAM_NATS_URL=nats://localhost:15002
UPSTREAM_NATS_USER=exchange_sync
UPSTREAM_NATS_PASS=123456
UPSTREAM_SUBJECT_PREFIX=exchange

# Exchange Adapter Service REST API (for historical candle pre-loading)
EXCHANGE_ADAPTER_URL=http://localhost:9100
HISTORY_PRELOAD_DAYS=3

CANDLE_BUFFER_SIZE=1000
LOG_LEVEL=INFO

