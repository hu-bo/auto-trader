APP_ENV=development
APP_PORT=9004

# Signal NATS — publish signals & notifications to trader-service-node
SIGNAL_NATS_URL=nats://localhost:16001
SIGNAL_NATS_USER=xxx
SIGNAL_NATS_PASS=xxx
SIGNAL_SUBJECT_PREFIX=sig.v1
SIGNAL_STRATEGY_SUBJECT_PREFIX=sig.v1.signal

# Upstream NATS — subscribe candle data from exchange-adapter-service
# Leave empty to use the signal NATS for both
UPSTREAM_NATS_URL=nats://xxx:15001
UPSTREAM_NATS_USER=xxx
UPSTREAM_NATS_PASS=xxx
UPSTREAM_SUBJECT_PREFIX=exchange

# Strategy Engine gRPC
GRPC_PORT=9005
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_FILE=../../certs/grpc/shared.crt
GRPC_TLS_KEY_FILE=../../certs/grpc/shared.key
GRPC_TLS_CA_FILE=../../certs/grpc/shared.crt


# Exchange Adapter Service REST API (for historical candle pre-loading)
EXCHANGE_ADAPTER_URL=http://localhost:9100
EXCHANGE_ADAPTER_API_KEY=
HISTORY_PRELOAD_DAYS=3

CANDLE_BUFFER_SIZE=1000
LOG_LEVEL=INFO
# Optional: write file logs in development too
# LOG_TO_FILE=true
# LOG_DIR=logs
